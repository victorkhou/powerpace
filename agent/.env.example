# ── Supabase (server-side only — NEVER expose the service-role key to the browser) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Model providers ──
ANTHROPIC_API_KEY=sk-ant-...
# Phase 4: add a second provider
# OPENAI_API_KEY=sk-...

# ── LangSmith observability (Phase 0) ──
# Get a key at https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=powerpace-coach

# ── Models (swap freely — see config.py) ──
COACH_MODEL=anthropic:claude-opus-4-8
JUDGE_MODEL=anthropic:claude-haiku-4-5

# ── Hardening (see config.py / main.py) ──
# Shared secret the Next.js route must send as the x-coach-secret header. REQUIRED
# unless COACH_ENV=development. Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
COACH_SHARED_SECRET=
# Kill-switch for the paid LLM path (true/false).
COACH_ENABLED=true
# Set to "development" to allow auth-disabled startup and verbose error bodies.
# Leave UNSET in any shared/deployed environment (fail-closed).
COACH_ENV=development

# ── Evals (Phase 3) — the user whose real data the eval set is built from ──
EVAL_USER_ID=
